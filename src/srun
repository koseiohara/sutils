# Source this file from Bash or zsh. The implementation lives in Python so
# both shells expose the same srun behavior.
if [ -n "${ZSH_VERSION-}" ]; then
    eval '_srun_source=${${(%):-%x}:A}'
elif [ -n "${BASH_VERSION-}" ]; then
    _srun_source=${BASH_SOURCE[0]}
else
    printf '%s\n' 'srun: only Bash and zsh are supported' >&2
    return 2
fi

_SUTILS_SRUN_ROOT=$(
    builtin cd -P -- "$(dirname -- "$_srun_source")" && pwd
) || return
unset _srun_source

srun()
{
    local srun_shell

    if [ -n "${ZSH_VERSION-}" ]; then
        srun_shell=zsh
    elif [ -n "${BASH_VERSION-}" ]; then
        srun_shell=bash
    else
        printf '%s\n' 'srun: only Bash and zsh are supported' >&2
        return 2
    fi

    command python3 \
        "$_SUTILS_SRUN_ROOT/sutil_modules/sutils_core.py" \
        srun --shell "$srun_shell" -- "$@"
}
